<!doctype html>
<html lang="en">

<head>
  <title>Nintendo TVii</title>
  <meta http-equiv="content-type" content="text/html; charset=UTF-8" />
  <link href="/css/vino.css" rel="stylesheet" />
  <script>
    function handleScriptError(scriptName) {
      alert("Error !!!:" + scriptName);
    }
    if (!window.vino) {
      document.write('<script src="/js/vino_emu.js"><\/script>');
    }
  </script>
  <script src="/js/jquery-3.7.1.min.js" onerror="handleScriptError('jquery-3.7.1.min.js')"></script>
  <script src="/js/base64.min.js" onerror="handleScriptError('base64.min.js')"></script>
  <script src="/js/vino.js" onerror="handleScriptError('vino.js')"></script>
  <%
var scriptFile = "loc-en_US.js"; // default

if (typeof lang === "string") {
  var l = lang.toLowerCase();

  if (l === "es") {
    scriptFile = "loc-es_419.js";
  } else if (l === "fr") {
    scriptFile = "loc-fr_CA.js";
  } else if (l === "en") {
    scriptFile = "loc-en_US.js";
  }
}
%>

  <script src="/js/<%= scriptFile %>" onerror="handleScriptError('<%= scriptFile %>')"></script>

</head>

