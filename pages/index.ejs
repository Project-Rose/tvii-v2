<!doctype html>
<html lang="en">

<head>
  <title>Nintendo TVii</title>
  <meta http-equiv="content-type" content="text/html; charset=UTF-8" />
  <link href="/css/vino.css" rel="stylesheet" />
  <script>
    function handleScriptError(scriptName) {
      alert("Error !!!:" + scriptName);
    }
    if (!window.vino) {
      document.write('<script src="/js/vino_emu.js"><\/script>');
    }
  </script>
  <script src="/js/jquery-3.7.1.min.js" onerror="handleScriptError('jquery-3.7.1.min.js')"></script>
  <script src="/js/vino.js" onerror="handleScriptError('vino.js')"></script>
  <%
var scriptFile = "loc-en_US.js"; // default

if (typeof lang === "string") {
  var l = lang.toLowerCase();

  if (l === "es") {
    scriptFile = "loc-es_419.js";
  } else if (l === "fr") {
    scriptFile = "loc-fr_CA.js";
  } else if (l === "en") {
    scriptFile = "loc-en_US.js";
  }
}
%>

  <script src="/js/<%= scriptFile %>" onerror="handleScriptError('<%= scriptFile %>')"></script>

</head>

<body data-pid="<%- pid %>" data-lang="<%= lang %>" data-country="<%- country %>" data-tv-provider-tz="<%- tz_name %>" data-region="<%- region %>" data-utc-offset="<%- utc_offset %>" data-tv-provider-id="<%- tv_provider_id %>">

  <img style="display: none" src="/img/feeling_sprite.png" width="0" height="0" />
  <img style="display: none" src="/img/spoiler-button.png" width="0" height="0" />
  <img style="display: none" src="/img/bg-postm-bar.png" width="0" height="0" />
  <img style="display: none" src="/img/bg_bar_purple.png" width="0" height="0" />
  <img style="display: none" src="/img/bg_bar_red.png" width="0" height="0" />

  <div class="wrapper">
    <button style="display: none" class="title-program-up hidden-e hidden-&"></button>
    <button style="display: none" class="title-program-down hidden-d hidden-("></button>
    <button style="display: none" class="title-program-confirm hidden-a"></button>

    <div class="top">
      <div class="header home-page">
        <a href="javascript:void(0)" class="exit"></a>
        <a href="javascript:void(0)" class="menu" data-loc="vino.home.header.menu"></a>
        <div class="tabs">
          <a href="javascript:void(0)" data-loc="vino.home.header.live" class="selected"></a>
          <a href="javascript:void(0)" data-loc="vino.home.header.guide"></a>
          <a href="javascript:void(0)" data-loc="vino.home.header.rec"></a>
        </div>
      </div>

      <div class="header pr-details" style="display: none">
        <a href="javascript:void(0)" class="return-top"></a>
        <a href="javascript:void(0)" class="favorite"></a>
        <p>
          <span></span>
        </p>
      </div>

      <div class="header miiverse" style="display: none">
        <a href="javascript:void(0)" class="help"></a>
        <span></span>
      </div>

      <div class="spacing" style="height: 70px; display: block"></div>
    </div>

    <div class="program-central"></div>

    <div class="guide-view" style="display: none">
      <div class="guide-time-container">
      </div>
      <div class="guide-channel-container">
      </div>
      <div class="guide-container l-stick-scroll">
      </div>
    </div>

    <div class="menu-modal popup" style="display: none">
    </div>

    <div class="miiverse-modal" style="display: none">
    </div>

    <div class="program-fulldetails-page" style="display: none">
    </div>

    <div class="miiverse-post-modal popup" style="display: none">
    </div>

    <div class="miiverse-user-details popup" style="display: none">
    </div>

    <div class="miiverse-doodle-modal popup" style="display: none">
    </div>

    <div class="footer">
      <div class="spacing" style="height: 90px; display: block"></div>
      <div class="bottom">
        <a href="javascript:void(0)" class="back accesskey-b"></a>
        <a href="javascript:void(0)" class="tune-in accesskey-x"></a>
        <div class="miiverse-preview" style="display: none">
          <img src="/img/noimg.png" />
          <span></span>
          <a href="javascript:void(0)" class="miiverse-button">
          </a>
        </div>
        <span class="miiverse-text" data-loc="vino.home.olv.crosspost.message">
        </span>
        <a href="javascript:void(0)" class="miiverse-post disabled">
          <span data-loc="vino.post"></span>
        </a>
        <div class="guide-button">
          <div class="guide-navi">
            <a href="javascript:void(0)" class="left"></a>
            <a href="javascript:void(0)" class="right"></a>
          </div>
        </div>

        <div class="clock">
          <span class="date"></span>
          <span class="day"></span>
          <span class="sep"></span>
          <span class="hour">00<span>:</span>00</span>
        </div>
      </div>
    </div>
  </div>

    <script type="text/template" class="miiverse-user-details-template" style="display: none">
      <div class="dialog-container mv-user-detail-container">

        <img class="mii" src="/img/mii-hidden.png">

        <p class="display-name">-----</p>
        <p class="nnid">-----</p>

        <p class="post-count">-----</p>

        <a href="javascript:void(0)" data-loc="vino.home.olv.modal.jump_miiverse_post" navi_target class="miiverse-jump disabled">
        </a>
        
        <div class="dialog-buttons">
          <a href="javascript:void(0)" navi_target="" class="btn-1 accesskey-b" data-loc="vino.cancel-withb"></a>
          <a href="javascript:void(0)" navi_target="" class="btn-2 friend-status">
            <span class="add" style="display: none;" data-loc="vino.home.olv.modal.add_friend"></span>
            <span class="already" style="display: none;" data-loc="vino.home.olv.modal.is_friends"></span>
            <span class="myself" style="display: none;" data-loc="vino.home.olv.modal.is_myself"></span>
          </a>
        </div>

      </div>
    </script>

    <script type="text/template" class="menu-screen-template" style="display: none">
      <div class="menu-container">
        
      </div>
    </script>


  <script type="text/template" class="program-fulldetails-page-template" style="display: none">
      <a href="javascript:void(0)" class="accesskey-l prev-page" style="display: none"></a>
      <a href="javascript:void(0)" class="accesskey-r next-page"></a>
      <div class="content">

        <div class="program-slide program-image-detail">
          <div class="program-image">
            <img src="/img/noimg.png" />
          </div>
        </div>

        <div class="program-slide program-airing-details">
          <div class="program-details">

            <div class="program-airing">
              <span class="date"></span>
              <div class="channel-detail">
                <img class="chlogo" src="/img/noimg.png" style="display: block" />
                <span class="chname"></span>
                <span class="chnumber"></span>
                <span class="prinfo">
                  <span class="tag" style="display: none"></span>
                  <span class="info-other"></span>
                </span>
                <span class="scoreinfo">
                  <span class="text"></span>
                  <span class="metascore" style="display: none"></span>
                </span>
              </div>
            </div>
            <div class="program-description">
              <!--<span></span>-->
              <p class="no-episode"></p>
            </div>
          </div>
        </div>

        <div class="program-slide program-detail-desc">
          <div class="parent-description">
            <span data-loc="vino.home.program.details_label"></span>
            <p></p>
          </div>
        </div>

        <div class="program-slide program-actors">
          <div class="actor-container">
            <span class="actor-link" data-loc="vino.home.program.cast"></span>
          </div>
        </div>

        <div class="program-slide program-metadata">
          <div class="info">
            <span class="genre">
              <span class="label" data-loc="vino.home.program.genre"></span>
              <span class="text"></span>
            </span>
            <span class="og-duration">
              <span class="label" data-loc="vino.home.program.airing_duration"></span>
              <span class="text"></span>
            </span>
          </div>
        </div>

        <div class="program-slide program-buttons">
          <div class="related-buttons">
            <a navi_target href="javascript:void(0)" class="view-all-airings disabled">
              <span data-loc="vino.home.program.button.view_future_airing"></span>
            </a>
            <span class="sep"></span>
            <a navi_target href="javascript:void(0)" class="reminder disabled">
              <span data-loc="vino.home.program.button.set_reminder"></span>
            </a>
            <a navi_target href="javascript:void(0)" class="recommend  disabled">
              <span data-loc="vino.home.program.button.send_friend_rec"></span>
            </a>
          </div>
        </div>

      </div>
    </script>

  <script type="text/template" class="miiverse-modal-template" style="display: none">
    <div class="miiverse-button-menu">
        <a href="javascript:void(0)" class="miiverse-top">
        </a>
        <a href="javascript:void(0)" class="miiverse-refresh disabled">
        </a>
        <a href="javascript:void(0)" class="miiverse-doodle-default disabled">
        </a>
      </div>
      <div class="post-container l-stick-scroll">

      </div>
    </script>

  <script type="text/template" class="miiverse-post-modal-template" style="display: none">
    <div class="dialog-container">
        <div class="popup-header"></div>
        <div class="post-menu">
          <div tabindex="0" navi_target class="mii">
            <img src="/img/noimg.png" />
          </div>

          <ul class="feeling-buttons">
            <li class="checked feeling-button-normal">
              <input navi_target navi_no_reset type="radio" name="feeling_id" value="0" checked="" />
            </li>
            <li class="feeling-button-happy">
              <input navi_target navi_no_reset type="radio" name="feeling_id" value="1" />
            </li>
            <li class="feeling-button-like">
              <input navi_target navi_no_reset type="radio" name="feeling_id" value="2" />
            </li>
            <li class="feeling-button-surprised">
              <input navi_target navi_no_reset type="radio" name="feeling_id" value="3" />
            </li>
            <li class="feeling-button-frustrated">
              <input navi_target navi_no_reset type="radio" name="feeling_id" value="4" />
            </li>
            <li class="feeling-button-puzzled">
              <input navi_target navi_no_reset type="radio" name="feeling_id" value="5" />
            </li>
          </ul>

          <label navi_target navi_no_reset class="spoiler-button">
           <span data-loc="vino.home.olv.crosspost.post.spoilers"></span>
            <input type="checkbox" name="is_spoiler" value="1" />
          </label>

          <div class="textarea-container textarea-with-menu">
            <menu class="textarea-menu">
              <li>
                <label id="text" class="textarea-menu-text checked">
                  <input navi_target navi_no_reset autocomplete="off" tabindex="1" type="radio" name="_post_type" value="body" checked />
                </label>
              </li>

              <li class="test-painting-tab">
                <label id="memo" class="textarea-menu-memo">
                  <input navi_target navi_no_reset autocomplete="off" tabindex="1" type="radio" name="_post_type" value="painting" />
                </label>
              </li>
            </menu>

            <div class="textarea-text">
              <textarea navi_target navi_no_reset wrap="soft" autocomplete="off" type="text" name="body" class="textarea-text-input" value="" maxlength="200" data-loc-attr='{"placeholder":"vino.home.olv.crosspost.post.text_placeholder"}'></textarea>

              <div class="textarea-text-preview placeholder" data-loc-attr='{"data-placeholder":"vino.home.olv.crosspost.post.text_placeholder"}'>
              </div>
            </div>

            <div class="textarea-memo" style="display: none">
              <div tabindex="0" navi_target navi_no_reset class="textarea-memo-preview" style="background-image: url(/img/noimg.png)"></div>
              <input autocomplete="off" type="hidden" class="textarea-memo-value" name="painting" disabled />
            </div>
          </div>
        </div>
        <div class="dialog-buttons">
          <a href="javascript:void(0)" navi_target class="btn-1 accesskey-b" data-loc="vino.cancel-withb"></a>
          <a href="javascript:void(0)" navi_target class="btn-2"  data-loc="vino.post"></a>
        </div>
      </div>
    </script>

