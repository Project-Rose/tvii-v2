        <a><span style="background:#663300;"></span></a>
        <a><span style="background:#331a00;"></span></a>

        <!-- Skin tones -->
        <a><span style="background:#ffe0cc;"></span></a>
        <a><span style="background:#ffcc99;"></span></a>
        <a><span style="background:#e6ac7a;"></span></a>
        <a><span style="background:#b37447;"></span></a>
        <a><span style="background:#663d26;"></span></a>

        <a href="javascript:void(0)" class="custom">
          <input type="text" value="#ffffff" minlength="4" maxlength="7">
          <span style="background: #ffffff;"></span>
        </a>
      </div>

      <div class="canvas-container">
        <!-- Base screenshot -->
        <canvas id="baseCanvas" width="704" height="396"></canvas>
        <!-- Transparent doodle layer -->
        <canvas id="drawCanvas" width="704" height="396"></canvas>
      </div>

      <div class="size-container">
        <a href="javascript:void(0)" class="minus accesskey-m"></a>
        <p data-loc="vino.home.olv.crosspost.post.doodle_pen_size"></p><span>6</span>
        <a href="javascript:void(0)" class="plus accesskey-p"></a>
      </div>

      <div class="comment">
        <textarea wrap="soft" autocomplete="off" type="text" name="body" value="" maxlength="200"
        data-loc-attr='{"placeholder":"vino.home.olv.crosspost.post.placeholder_doodle"}'></textarea>
      </div>

      <a href="javascript:void(0)" class="finish-doodle-modal">
        <span data-loc="vino.post"></span>
      </a>
      <a href="javascript:void(0)" class="back-modal accesskey-b"></a>
    </script>

